{
  "name": "sprocket-and-sprout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "description": "A cozy pixel-art farm-factory game.",
  "author": "jacksonwalley",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.jacksonwalley.sprocketandsprout",
    "productName": "Sprocket & Sprout",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Sprocket-and-Sprout-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Sprocket-and-Sprout-Portable-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.simulation-games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
